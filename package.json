{
  "name": "opencode-session-search",
  "version": "1.0.1",
  "description": "OponBackgroundEventenCode plugin for searching and retrieving chat history",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "files": [
    "dist",
    "index.ts",
    "history.ts",
    "database.ts",
    "v1.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/install-local.sh"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outfile ./dist/index.js --target bun --format esm --external @opencode-ai/plugin",
    "typecheck": "tsc --noEmit",
    "install:local": "bash scripts/install-local.sh",
    "test": "bun test && bun run typecheck",
    "prepublishOnly": "bun run build && bun run test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "history",
    "search",
    "chat"
  ],
  "author": "Arthur Tyukayev",
  "license": "MIT",
  "repository": "github:arthurtyukayev/opencode-session-history",
  "bugs": "https://github.com/arthurtyukayev/opencode-session-history/issues",
  "homepage": "https://github.com/arthurtyukayev/opencode-session-history#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode/plugin": "^2.0.18",
    "bun": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": { "optional": true },
    "@opencode/plugin": { "optional": true }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.32",
    "@opencode/plugin": "2.0.18",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
